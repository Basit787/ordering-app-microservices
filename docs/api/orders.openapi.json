    "/admin/orders/{id}/status": {
      "patch": {
        "operationId": "AdminOrdersController_setStatus",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
