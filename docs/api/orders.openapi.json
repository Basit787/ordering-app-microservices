  "info": {
    "title": "Orders API",
    "description": "Carts, checkout and order tracking for shoppers; every order and its fulfilment for admins.\n\n**Authentication:** get a token from the auth service (`POST /auth/login`) and paste it into Authorize.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CartLineDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "description": "Current price, smallest currency unit"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "available": {
            "type": "boolean",
            "description": "false when the product is no longer sold or has too little stock"
          }
        },
        "required": [
          "productId",
          "name",
          "priceCents",
          "imageUrl",
          "quantity",
          "stock",
          "available"
        ]
      },
      "CartDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartLineDto"
            }
          },
          "totalCents": {
            "type": "number",
            "description": "Sum of the available lines"
          }
        },
        "required": [
          "items",
          "totalCents"
        ]
      },
      "SetCartItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "0 removes the line",
            "minimum": 0,
            "maximum": 99
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "India"
          }
        },
        "required": [
          "fullName",
          "phone",
          "line1",
          "city",
          "state",
          "postalCode",
          "country"
        ]
      },
      "CheckoutDto": {
        "type": "object",
        "properties": {
          "shippingAddress": {
            "$ref": "#/components/schemas/AddressDto"
          }
        },
        "required": [
          "shippingAddress"
        ]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "description": "Price paid, smallest currency unit"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "name",
          "priceCents",
          "quantity"
        ]
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          },
          "totalCents": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "rejected",
              "pending_payment",
              "paid",
              "payment_failed",
              "shipped",
              "delivered",
              "cancelled"
            ]
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "paymentId": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "userName",
          "items",
          "totalCents",
          "status",
          "shippingAddress",
          "paymentId",
          "failureReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "shipped",
              "delivered",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
