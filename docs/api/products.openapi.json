  "info": {
    "title": "Products API",
    "description": "The catalogue: public browsing, admin management of products and categories, and stock for orders.\n\n**Authentication:** get a token from the auth service (`POST /auth/login`) and paste it into Authorize.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "SaveCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "T-shirts"
          }
        },
        "required": [
          "name"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "description": "Smallest currency unit (paise)"
          },
          "stock": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "category": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryDto"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "priceCents",
          "stock",
          "imageUrl",
          "active",
          "category",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Blue cotton T-shirt"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "description": "Smallest currency unit (paise)",
            "example": 49900
          },
          "stock": {
            "type": "number",
            "example": 25
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "categoryId": {
            "type": "string",
            "nullable": true,
            "description": "null removes the category"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "priceCents",
          "stock"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Blue cotton T-shirt"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "description": "Smallest currency unit (paise)",
            "example": 49900
          },
          "stock": {
            "type": "number",
            "example": 25
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "categoryId": {
            "type": "string",
            "nullable": true,
            "description": "null removes the category"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
