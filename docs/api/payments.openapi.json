{
  "openapi": "3.0.0",
  "paths": {
    "/payments/orders/{orderId}": {
      "get": {
        "operationId": "PaymentsController_forOrder",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Payments"
        ]
      }
    },
    "/payments/orders/{orderId}/verify": {
      "post": {
        "operationId": "PaymentsController_verify",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyPaymentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Payments"
        ]
      }
    },
    "/admin/payments": {
      "get": {
        "operationId": "AdminPaymentsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "created",
                "succeeded",
                "failed",
                "refunded"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Admin: payments"
        ]
      }
    }
  },
  "info": {
    "title": "Payments API",
    "description": "Charges each new order through a mock gateway, refunds cancelled orders, and lists payments for admins.\n\n**Authentication:** get a token from the auth service (`POST /auth/login`) and paste it into Authorize.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RazorpayCheckoutDto": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string"
          },
          "razorpayOrderId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Smallest currency unit (paise)"
          },
          "currency": {
            "type": "string",
            "example": "INR"
          }
        },
        "required": [
          "keyId",
          "razorpayOrderId",
          "amount",
          "currency"
        ]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "amountCents": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "succeeded",
              "failed",
              "refunded"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "razorpay",
              "mock"
            ]
          },
          "razorpayPaymentId": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "checkout": {
            "nullable": true,
            "description": "Set while the payment waits for Checkout",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RazorpayCheckoutDto"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderId",
          "userId",
          "amountCents",
          "currency",
          "status",
          "provider",
          "razorpayPaymentId",
          "failureReason",
          "checkout",
          "createdAt"
        ]
      },
      "VerifyPaymentDto": {
        "type": "object",
        "properties": {
          "razorpayOrderId": {
            "type": "string",
            "example": "order_Ok3QbhB9dNJx2q"
          },
          "razorpayPaymentId": {
            "type": "string",
            "example": "pay_Ok3RCXfkM1sR9a"
          },
          "razorpaySignature": {
            "type": "string"
          }
        },
        "required": [
          "razorpayOrderId",
          "razorpayPaymentId",
          "razorpaySignature"
        ]
      }
    }
  }
}
