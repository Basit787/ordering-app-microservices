# Signs and verifies every JWT; all services share it
JWT_SECRET=dev-secret-change-me

# First admin account, created by the auth service on start if the email is free
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@oam.local
ADMIN_PASSWORD=Admin123!

# Mock payment gateway: orders above this amount (paise) are declined
PAYMENT_LIMIT_CENTS=10000000

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Leave the keys empty to use the mock gateway.
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Object storage for product images (any S3-compatible store). Empty uses the local floci container from compose.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
