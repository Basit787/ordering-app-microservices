# One ignore file for the whole workspace (server, client apps, packages)

# Dependencies (Prisma clients are generated into node_modules/@prisma-db too)
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Tool caches
.turbo/
.tanstack/
.vite/
.nitro/
.output/
coverage/
.nyc_output/

# Environment: secrets stay local; the documented examples are committed
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code (kept local)
.claude
CLAUDE.md
